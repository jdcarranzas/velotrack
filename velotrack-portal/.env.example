# URL de la gateway de VeloTrack. Next reenvía /gateway/* a esta URL (sin CORS).
# Se lee al arrancar o construir: en producción hay que definirla antes de `next build`.
GATEWAY_URL=https://velotrack-gateway-732809824488.us-east1.run.app

# Id (talentms) del entrenador que usa el portal mientras no haya login.
NEXT_PUBLIC_COACH_ID=1
